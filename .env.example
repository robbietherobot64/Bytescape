# Bytescape Environment Configuration
# Copy to .env and fill in your values.

# === Required ===
DATABASE_URL=postgres://bytescape:bytescape@localhost:5432/bytescape
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars

# === Server ===
DOMAIN=localhost
PORT=8080
FRONTEND_URL=http://localhost:1420

# === S3 Storage (optional — falls back to local file storage) ===
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_BUCKET=bytescape-media
# S3_PUBLIC_BASE_URL=http://localhost:9000/bytescape-media

# === OAuth: Bluesky ===
BLUESKY_CLIENT_ID=http://127.0.0.1:8080/oauth/client-metadata.json
BLUESKY_REDIRECT_URI=http://127.0.0.1:8080/api/auth/bluesky/callback
BLUESKY_AUTHORIZE_URL=https://bsky.social/oauth/authorize
BLUESKY_TOKEN_URL=https://bsky.social/oauth/token
BLUESKY_PAR_URL=https://bsky.social/oauth/par
BLUESKY_PLC_DIRECTORY=https://plc.directory
BLUESKY_SCOPE=atproto transition:generic
# Bluesky chat service for 1:1 DMs (AD-01d — Bytescape acts as a chat client)
CHAT_SERVICE_URL=https://chat.bsky.social
# === OAuth: Mastodon ===
MASTODON_REDIRECT_URI=http://localhost:8080/api/auth/mastodon/callback

# === OAuth: Google ===
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# === Email (SMTP) ===
# Leave empty to disable email sending (verification codes returned inline in dev).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=noreply@bytescape.social

# === Captcha ===
# Leave empty to disable captcha (for local dev).
HCAPTCHA_SECRET=
HCAPTCHA_SITE_KEY=

# === Access Control ===
REQUIRE_INVITE_CODE=false
ADMIN_TOKEN=changeme-admin-token
