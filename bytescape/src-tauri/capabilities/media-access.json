{
    "$schema": "../gen/schemas/desktop-schema.json",
    "identifier": "media-access",
    "description": "Allow access to media directory",
    "windows": [
        "main"
    ],
    "permissions": [
        {
            "identifier": "fs:allow-read",
            "allow": [
                {
                    "path": "$APPDATA/media/**"
                }
            ]
        }
    ]
}